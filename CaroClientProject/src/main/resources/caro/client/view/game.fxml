<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import caro.client.view.BoardCanvas?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="caro.client.controller.GameController"
            stylesheets="@css/base.css, @css/game.css" styleClass="game-root">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <center>
        <BoardCanvas fx:id="boardCanvas"/>
    </center>

    <right>
        <VBox spacing="10" prefWidth="270" styleClass="side-panel">
            <BorderPane.margin><Insets left="12"/></BorderPane.margin>
            <Label text="Bàn cờ" styleClass="game-title"/>
            <Label fx:id="infoLabel" styleClass="info-label" wrapText="true"/>
            <Label fx:id="turnLabel" styleClass="turn-label" wrapText="true"/>
            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"/>
            <Button text="Về màn hình đầu" onAction="#back"/>
            <fx:include source="chat.fxml"/>
        </VBox>
    </right>
</BorderPane>

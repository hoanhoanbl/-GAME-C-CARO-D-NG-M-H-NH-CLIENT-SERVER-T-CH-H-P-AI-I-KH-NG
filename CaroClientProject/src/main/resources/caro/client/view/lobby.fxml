<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="caro.client.controller.LobbyController"
      spacing="16"
      stylesheets="@css/base.css, @css/lobby.css"
      style="-fx-background-color: #f7fafc; -fx-padding: 24;">

    <!-- Thanh tiêu đề trên cùng -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: white; -fx-padding: 16 24; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 3);">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="SẢNH CHỜ TRÒ CHƠI" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2b6cb0;"/>
            <Label fx:id="welcomeLabel" text="Xin chào người chơi!" style="-fx-font-size: 14px; -fx-text-fill: #4a5568;"/>
        </VBox>
        <Button text="Đăng xuất" onAction="#handleLogout"
                style="-fx-pref-height: 36px; -fx-background-color: #e53e3e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"/>
    </HBox>

    <!-- Khu vực nội dung chính: Chia làm 2 cột -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Cột trái: Danh sách phòng đấu (70%) -->
        <VBox spacing="12" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 3);">
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Danh sách phòng online" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                    <Label text="Chọn một phòng còn trống để thi đấu hoặc tạo phòng riêng" style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
                </VBox>
                <Button text="Làm mới" onAction="#handleRefresh"
                        style="-fx-pref-height: 32px; -fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-cursor: hand; -fx-background-radius: 6;"/>
            </HBox>

            <!-- Bảng danh sách phòng -->
            <TableView fx:id="roomsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 6;">
                <columns>
                    <TableColumn fx:id="roomIdCol" text="Mã phòng" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    <TableColumn fx:id="ownerCol" text="Chủ phòng" prefWidth="220" style="-fx-alignment: CENTER-LEFT;"/>
                    <TableColumn fx:id="statusCol" text="Trạng thái" prefWidth="160" style="-fx-alignment: CENTER;"/>
                </columns>
                <placeholder>
                    <Label text="Hiện chưa có phòng đấu nào. Hãy nhấn 'Tạo phòng' để bắt đầu!" style="-fx-text-fill: #a0aec0; -fx-font-size: 13px;"/>
                </placeholder>
            </TableView>

            <!-- Các nút hành động phòng -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button fx:id="createRoomBtn" text="➕ Tạo phòng mới" onAction="#handleCreateRoom"
                        style="-fx-pref-height: 38px; -fx-background-color: #3182ce; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 0 16;"/>
                <Button fx:id="joinRoomBtn" text="Vào phòng" onAction="#handleJoinRoom"
                        style="-fx-pref-height: 38px; -fx-background-color: #38a169; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6; -fx-padding: 0 16;"/>
            </HBox>
        </VBox>

        <!-- Cột phải: Chơi với máy & Thông tin (30%) -->
        <VBox spacing="16" prefWidth="280"
              style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 3);">
            <VBox spacing="4">
                <Label text="Chơi với máy (AI)" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                <Label text="Rèn luyện kỹ năng với trí tuệ nhân tạo" style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
            </VBox>

            <Separator/>

            <VBox spacing="8">
                <Label text="Độ khó của máy:" style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 13px;"/>
                <ComboBox fx:id="difficultyComboBox" maxWidth="Infinity" style="-fx-pref-height: 36px; -fx-background-radius: 6;"/>
            </VBox>

            <Button text="🤖 Bắt đầu chơi với máy" onAction="#handlePlayWithBot" maxWidth="Infinity"
                    style="-fx-pref-height: 42px; -fx-background-color: #805ad5; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 6;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Khung thông báo trạng thái phía dưới -->
            <VBox style="-fx-background-color: #ebf8ff; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #bee3f8; -fx-border-radius: 6;">
                <Label text="💡 Hướng dẫn:" style="-fx-font-weight: bold; -fx-text-fill: #2b6cb0; -fx-font-size: 12px;"/>
                <Label text="Nhấn Tạo phòng để chờ người khác tham gia, hoặc nhấn đúp chuột vào phòng đang chờ để ghép ván!" wrapText="true" style="-fx-font-size: 12px; -fx-text-fill: #4a5568;"/>
            </VBox>
        </VBox>
    </HBox>

    <!-- Thông báo lỗi hoặc trạng thái -->
    <Label fx:id="messageLabel" maxWidth="Infinity" alignment="CENTER"
           style="-fx-font-size: 13px; -fx-text-fill: #e53e3e; -fx-min-height: 18px;"/>
</VBox>

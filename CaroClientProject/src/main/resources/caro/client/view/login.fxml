<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="caro.client.controller.LoginController"
      alignment="CENTER" spacing="15"
      stylesheets="@css/base.css, @css/login.css"
      style="-fx-background-color: #f0f2f5; -fx-padding: 20;">

    <VBox alignment="CENTER" spacing="6">
        <Label text="GAME CỜ CARO" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2b6cb0;"/>
        <Label text="Đăng nhập tài khoản để lưu thành tích và tham gia phòng đấu" style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
    </VBox>

    <VBox maxWidth="420" spacing="16"
          style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 12, 0, 0, 5);">

        <!-- Thanh chuyển đổi Đăng nhập / Đăng ký -->
        <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #edf2f7; -fx-background-radius: 8; -fx-padding: 4;">
            <Button fx:id="loginTabBtn" text="Đăng nhập" onAction="#showLoginView" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-pref-height: 36px; -fx-background-color: #3182ce; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
            <Button fx:id="registerTabBtn" text="Đăng ký" onAction="#showRegisterView" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                    style="-fx-pref-height: 36px; -fx-background-color: transparent; -fx-text-fill: #4a5568; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
        </HBox>

        <!-- Form nhập liệu -->
        <VBox spacing="12">
            <!-- Tên đăng nhập -->
            <VBox spacing="4">
                <Label text="Tên đăng nhập (Username):" style="-fx-font-weight: bold; -fx-text-fill: #2d3748; -fx-font-size: 13px;"/>
                <TextField fx:id="usernameField" promptText="3 - 16 ký tự (chữ, số, _)"
                           style="-fx-pref-height: 38px; -fx-font-size: 14px; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Email (chỉ hiện khi Đăng ký) -->
            <VBox fx:id="emailBox" spacing="4" visible="false" managed="false">
                <Label text="Email (tùy chọn):" style="-fx-font-weight: bold; -fx-text-fill: #2d3748; -fx-font-size: 13px;"/>
                <TextField fx:id="emailField" promptText="email@example.com (để trống được)"
                           style="-fx-pref-height: 38px; -fx-font-size: 14px; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Mật khẩu -->
            <VBox spacing="4">
                <Label text="Mật khẩu:" style="-fx-font-weight: bold; -fx-text-fill: #2d3748; -fx-font-size: 13px;"/>
                <PasswordField fx:id="passwordField" promptText="Từ 6 đến 32 ký tự"
                               style="-fx-pref-height: 38px; -fx-font-size: 14px; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Xác nhận mật khẩu (chỉ hiện khi Đăng ký) -->
            <VBox fx:id="confirmPasswordBox" spacing="4" visible="false" managed="false">
                <Label text="Xác nhận mật khẩu:" style="-fx-font-weight: bold; -fx-text-fill: #2d3748; -fx-font-size: 13px;"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu"
                               style="-fx-pref-height: 38px; -fx-font-size: 14px; -fx-background-radius: 6;"/>
            </VBox>
        </VBox>

        <!-- Thông báo lỗi hoặc thành công -->
        <Label fx:id="messageLabel" wrapText="true" alignment="CENTER" maxWidth="Infinity"
               style="-fx-text-fill: #e53e3e; -fx-font-size: 13px; -fx-min-height: 18px;"/>

        <!-- Nút hành động chính -->
        <Button fx:id="actionBtn" text="Đăng nhập" onAction="#handleAction" maxWidth="Infinity"
                style="-fx-pref-height: 42px; -fx-background-color: #3182ce; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6;"/>

        <!-- Tuỳ chọn chơi offline hoặc chuyển nhanh -->
        <HBox alignment="CENTER" spacing="10">
            <Button text="Chơi với máy (Khách)" onAction="#handlePlayWithBot"
                    style="-fx-pref-height: 34px; -fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-font-size: 13px; -fx-cursor: hand; -fx-background-radius: 6;"/>
            <Button text="Đổi Server" onAction="#backToConnect"
                    style="-fx-pref-height: 34px; -fx-background-color: transparent; -fx-text-fill: #718096; -fx-font-size: 13px; -fx-cursor: hand; -fx-underline: true;"/>
        </HBox>
    </VBox>

</VBox>
